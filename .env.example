# Database; configure before enabling persistent storage
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/university_os?schema=public"

# SOGo/IMAP credentials must be kept server-side only.
# Do not commit real credentials to Git or expose them to the browser.
IMAP_HOST="imap.uni-koblenz.de"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
